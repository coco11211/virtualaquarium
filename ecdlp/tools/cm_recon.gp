p = 2^256 - 2^32 - 977;
n = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141;
t = p+1-n;
print("t = ", t);
print("4p - t^2 = ", 4*p - t^2);
v2 = (4*p - t^2)/3;
print("is 3| (4p-t^2): ", (4*p-t^2)%3);
print("v^2 = ", v2, " issquare: ", issquare(v2));
v = sqrtint(v2);
print("v = ", v);
print("check 4p = t^2+3v^2: ", 4*p == t^2+3*v^2);
print("v bits = ", #binary(v));
print("factor v:");
print(factor(v));
print("p mod 9 = ", p % 9);
print("p mod 3 = ", p % 3);
print("n mod 3 = ", n % 3);
print("7 is square mod p: ", issquare(Mod(7,p)));
print("7 is cube mod p: ", Mod(7,p)^((p-1)/3) == 1);
beta = 0x7AE96A2B657C07106E64479EAC3434E99CF0497512F58995C1396C28719501EE;
print("beta^3=1: ", Mod(beta,p)^3==1);
print("beta is cube mod p: ", Mod(beta,p)^((p-1)/3)==1);
print("gcd(n-1, small) factor n-1 partial:");
print(factor(n-1, 10^7));
print("valuation of v at small primes:");
for(l=2,200, if(isprime(l), if(v % l == 0, print("  l=",l," divides v, val=",valuation(v,l)))));
print("t factored:"); print(factor(t));
quit;
